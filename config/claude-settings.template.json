{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -r /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -fr ~)",
      "Bash(rm -r ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf ${HOME})",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(diskpart *)",
      "Bash(format *)",
      "Bash(mkfs *)",
      "Bash(shutdown *)",
      "mcp__specurai__execute_sql",
      "mcp__specurai__execute_ddl",
      "mcp__specurai__delete_connection",
      "mcp__specurai__migration_apply",
      "mcp__specurai__restore_run",
      "mcp__specurai__execute_maintenance_plan",
      "mcp__specurai__set_recovery_model",
      "mcp__moldplan-hq__execute_sql",
      "mcp__moldplan-hq__execute_mssql_staging_restore"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f -r *)",
      "Bash(rm -r -f *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git branch -D *)",
      "Bash(git rebase -i *)",
      "Bash(dotnet ef database drop *)",
      "Bash(dotnet ef migrations remove *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PY=$(command -v python3 || command -v python); exec \"$PY\" \"$HOME/.claude/hooks/agent-model-guard.py\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notification.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PY=$(command -v python3 || command -v python); exec \"$PY\" \"$HOME/.claude/hooks/auto-session-title.py\"'",
            "timeout": 10,
            "statusMessage": "自動命名 session…"
          }
        ]
      }
    ]
  }
}
