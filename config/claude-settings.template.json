{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 400000,
  "env": {
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -r /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -fr ~)",
      "Bash(rm -r ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf ${HOME})",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(diskpart *)",
      "Bash(format *)",
      "Bash(mkfs *)",
      "Bash(shutdown *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f -r *)",
      "Bash(rm -r -f *)",
      "Bash(dotnet ef database drop *)",
      "Bash(dotnet ef migrations remove *)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PY=$(command -v python3 || command -v python); exec \"$PY\" \"$HOME/.claude/hooks/agent-model-guard.py\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notification.sh notify",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notification.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PY=$(command -v python3 || command -v python); exec \"$PY\" \"$HOME/.claude/hooks/auto-session-title.py\"'",
            "timeout": 30,
            "statusMessage": "自動命名 session…"
          }
        ]
      }
    ]
  }
}
